{
  "name": "operation-frontline",
  "version": "1.0.0",
  "private": true,
  "description": "OPERATION: FRONTLINE — browser-based multiplayer military FPS (PlayCanvas + Colyseus + TypeScript)",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p client --noEmit && tsc -p tests --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:gameplay": "vitest run tests/gameplay",
    "test:multiplayer": "vitest run tests/multiplayer",
    "test:perf": "vitest run tests/performance",
    "test:e2e": "node tests/e2e/run.mjs",
    "assets:fetch": "node scripts/fetch-assets.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.12.0",
    "esbuild": "^0.28.2",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
